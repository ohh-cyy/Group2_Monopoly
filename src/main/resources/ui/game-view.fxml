<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            prefWidth="1200"
            prefHeight="800">
    
    <!-- 顶部：标题和当前玩家信息 -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #074001; -fx-padding: 15;">
            <Label text="Monopoly Deal Card Game" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="currentPlayerLabel" 
                       text="Current Player: Player 1" 
                       style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="gameStatusText" 
                       text="Game in Progress" 
                       style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- 左侧：玩家列表和信息 -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="250">
            <Label text="Players" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="playersList" spacing="10">
                    <!-- 玩家信息将动态添加到这里 -->
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <!-- 中间：手牌 / 银行 / 地产 三等分 -->
    <center>
        <GridPane style="-fx-padding: 10;" vgap="8" hgap="0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" percentHeight="33.33" minHeight="100"/>
                <RowConstraints vgrow="ALWAYS" percentHeight="33.33" minHeight="100"/>
                <RowConstraints vgrow="ALWAYS" percentHeight="33.34" minHeight="100"/>
            </rowConstraints>

            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0"
                  GridPane.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 8;">
                <Label text="Your Hand"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                <ScrollPane fx:id="playerHandScroll" fitToWidth="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                    <HBox fx:id="playerHand"
                          spacing="6"
                          alignment="CENTER_LEFT"
                          style="-fx-padding: 4;"/>
                </ScrollPane>
            </VBox>

            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0"
                  GridPane.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 8;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Your Bank"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                    <Label fx:id="bankTotalLabel" text="Bank total: 0M"
                           style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS" maxHeight="Infinity">
                    <FlowPane fx:id="playerBank"
                              hgap="6"
                              vgap="6"
                              prefWrapLength="2000"
                              alignment="CENTER_LEFT"
                              style="-fx-padding: 4;"/>
                </ScrollPane>
            </VBox>

            <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0"
                  GridPane.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 8;">
                <Label text="Your Properties"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS" maxHeight="Infinity">
                    <FlowPane fx:id="playerProperties"
                              hgap="10"
                              vgap="8"
                              prefWrapLength="850"
                              alignment="CENTER_LEFT"
                              style="-fx-padding: 6;"/>
                </ScrollPane>
            </VBox>
        </GridPane>
    </center>
    
    <!-- 右侧：游戏控制和日志 -->
    <right>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="300">
            
            <!-- 游戏控制按钮 -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Game Controls" 
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Button fx:id="drawCardBtn" 
                        text="Draw Cards (2)" 
                        onAction="#onDrawCardsClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="playCardBtn" 
                        text="Play Selected Card" 
                        onAction="#onPlayCardClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="endTurnBtn" 
                        text="End Turn" 
                        onAction="#onEndTurnClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="newGameBtn" 
                        text="New Game" 
                        onAction="#onNewGameClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            
            <!-- 游戏日志 -->
            <Label text="Game Log" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TextArea fx:id="gameLog" 
                      editable="false" 
                      wrapText="true"
                      VBox.vgrow="ALWAYS"
                      style="-fx-font-size: 12px;"/>
        </VBox>
    </right>
    
    <!-- 底部：状态栏 -->
    <bottom>
        <HBox spacing="20" style="-fx-background-color: #074001; -fx-padding: 10;">
            <Label fx:id="statusMessage" 
                   text="Welcome to Monopoly Deal!" 
                   style="-fx-text-fill: #ffffff; -fx-font-size: 14px;"/>
        </HBox>
    </bottom>
</BorderPane>
