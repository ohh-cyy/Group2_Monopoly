<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            prefWidth="1200"
            prefHeight="800">
    
    <!-- 顶部：标题和当前玩家信息 -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #074001; -fx-padding: 15;">
            <Label text="Monopoly Deal Card Game" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="currentPlayerLabel" 
                       text="Current Player: Player 1" 
                       style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="gameStatusText" 
                       text="Game in Progress" 
                       style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- 左侧：玩家列表和信息 -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="250">
            <Label text="Players" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="playersList" spacing="10">
                    <!-- 玩家信息将动态添加到这里 -->
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <!-- 中间：上半公开区（全员地产 + 当前回合资金） / 下半私有区（自己手牌+银行） -->
    <center>
        <VBox spacing="8" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
            <VBox spacing="6" VBox.vgrow="SOMETIMES" minHeight="180" maxHeight="220"
                  style="-fx-background-color: #f4f6f7; -fx-background-radius: 8; -fx-padding: 8;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="全员地产（公开）"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="2"
                          style="-fx-background-color: white; -fx-padding: 6 12; -fx-background-radius: 6;">
                        <Label text="当前回合玩家资金" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                        <Label fx:id="turnBankLabel" text="0M"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                    </VBox>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                    <VBox fx:id="allPlayersPropertiesPanel" spacing="10" style="-fx-padding: 4;"/>
                </ScrollPane>
            </VBox>

            <HBox spacing="10" VBox.vgrow="ALWAYS" minHeight="350">
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 8;">
                    <Label text="我的手牌（仅自己可见）"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                    <ScrollPane fx:id="playerHandScroll" fitToWidth="true"
                                hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                VBox.vgrow="ALWAYS" pannable="true">
                        <HBox fx:id="playerHand" spacing="10" alignment="CENTER_LEFT"
                              style="-fx-padding: 8;"/>
                    </ScrollPane>
                </VBox>
                <VBox spacing="6" prefWidth="380" maxWidth="420" minWidth="320"
                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 8;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="我的银行（仅自己可见）"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
                        <Label fx:id="bankTotalLabel" text="0M"
                               style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="playerBank" hgap="6" vgap="6" prefWrapLength="350"
                                  alignment="CENTER_LEFT" style="-fx-padding: 4;"/>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- 右侧：游戏控制和日志 -->
    <right>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="300">
            
            <!-- 游戏控制按钮 -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Game Controls" 
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Button fx:id="drawCardBtn" 
                        text="Draw Cards (2)" 
                        maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="playCardBtn" 
                        text="Play Selected Card" 
                        maxWidth="Infinity"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="endTurnBtn" 
                        text="End Turn" 
                        maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="newGameBtn" 
                        text="New Game" 
                        maxWidth="Infinity"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            
            <!-- 游戏日志 -->
            <Label text="Game Log" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TextArea fx:id="gameLog" 
                      editable="false" 
                      wrapText="true"
                      VBox.vgrow="ALWAYS"
                      style="-fx-font-size: 12px;"/>
        </VBox>
    </right>
    
    <!-- 底部：状态栏 -->
    <bottom>
        <HBox spacing="20" style="-fx-background-color: #074001; -fx-padding: 10;">
            <Label fx:id="statusMessage" 
                   text="Welcome to Monopoly Deal!" 
                   style="-fx-text-fill: #ffffff; -fx-font-size: 14px;"/>
        </HBox>
    </bottom>
</BorderPane>
