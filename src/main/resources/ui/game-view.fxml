<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            prefWidth="1200"
            prefHeight="800">
    
    <!-- 顶部：标题和当前玩家信息 -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Monopoly Deal Card Game" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="currentPlayerLabel" 
                       text="Current Player: Player 1" 
                       style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="gameStatusText" 
                       text="Game in Progress" 
                       style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- 左侧：玩家列表和信息 -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="250">
            <Label text="Players" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="playersList" spacing="10">
                    <!-- 玩家信息将动态添加到这里 -->
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <!-- 中间：主要游戏区域 -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            
            <!-- 对手的手牌（背面显示） -->
            <TitledPane text="Opponents' Hands" expanded="false">
                <VBox fx:id="opponentsHands" spacing="10"/>
            </TitledPane>
            
            <!-- 中央游戏区域 - 牌堆和弃牌堆 -->
            <HBox spacing="30" alignment="CENTER" VBox.vgrow="ALWAYS">
                <VBox spacing="5" alignment="CENTER">
                    <StackPane fx:id="drawPile" 
                               style="-fx-background-color: #3498db; -fx-pref-width: 100; -fx-pref-height: 140; -fx-border-color: #2c3e50; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;"
                               onMouseClicked="#onDrawPileClick">
                        <Label text="Draw Pile" 
                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="drawPileCount" text="Cards: 0"/>
                </VBox>
                
                <VBox spacing="5" alignment="CENTER">
                    <StackPane fx:id="discardPile" 
                               style="-fx-background-color: #95a5a6; -fx-pref-width: 100; -fx-pref-height: 140; -fx-border-color: #2c3e50; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;">
                        <Label text="Discard" 
                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="discardPileCount" text="Cards: 0"/>
                </VBox>
            </HBox>
            
            <!-- 当前玩家的手牌 -->
            <TitledPane text="Your Hand" expanded="true" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED">
                    <FlowPane fx:id="playerHand" 
                              hgap="10" 
                              vgap="10" 
                              alignment="CENTER"
                              style="-fx-padding: 10;"/>
                </ScrollPane>
            </TitledPane>
            
            <!-- 当前玩家的银行（现金牌） -->
            <TitledPane text="Your Bank" expanded="true">
                <VBox spacing="8" style="-fx-padding: 10;">
                    <Label fx:id="bankTotalLabel" text="Bank total: 0M"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <ScrollPane fitToWidth="true" prefHeight="120" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER">
                        <FlowPane fx:id="playerBank"
                                  hgap="10"
                                  vgap="10"
                                  prefWrapLength="700"
                                  style="-fx-padding: 5;"/>
                    </ScrollPane>
                </VBox>
            </TitledPane>

            <!-- 当前玩家的地产（按颜色分组，可放多张） -->
            <TitledPane text="Your Properties" expanded="true">
                <ScrollPane fitToWidth="true" prefHeight="180" vbarPolicy="AS_NEEDED">
                    <VBox fx:id="playerProperties"
                          spacing="10"
                          style="-fx-padding: 10;"/>
                </ScrollPane>
            </TitledPane>
        </VBox>
    </center>
    
    <!-- 右侧：游戏控制和日志 -->
    <right>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" 
              prefWidth="300">
            
            <!-- 游戏控制按钮 -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Game Controls" 
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Button fx:id="drawCardBtn" 
                        text="Draw Cards (2)" 
                        onAction="#onDrawCardsClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="playCardBtn" 
                        text="Play Selected Card" 
                        onAction="#onPlayCardClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="endTurnBtn" 
                        text="End Turn" 
                        onAction="#onEndTurnClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button fx:id="newGameBtn" 
                        text="New Game" 
                        onAction="#onNewGameClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            
            <!-- 游戏日志 -->
            <Label text="Game Log" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TextArea fx:id="gameLog" 
                      editable="false" 
                      wrapText="true"
                      VBox.vgrow="ALWAYS"
                      style="-fx-font-size: 12px;"/>
        </VBox>
    </right>
    
    <!-- 底部：状态栏 -->
    <bottom>
        <HBox spacing="20" style="-fx-background-color: #34495e; -fx-padding: 10;">
            <Label fx:id="statusMessage" 
                   text="Welcome to Monopoly Deal!" 
                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
        </HBox>
    </bottom>
</BorderPane>
