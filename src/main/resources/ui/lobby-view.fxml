<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LobbyController"
            prefWidth="520"
            prefHeight="420"
            style="-fx-padding: 24; -fx-background-color: #ecf0f1;">
    <center>
        <VBox spacing="16" alignment="CENTER" maxWidth="420">
            <Label text="Monopoly Deal"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <Label text="2 人联机调试 · TCP + JSON"
                   style="-fx-font-size: 14px; -fx-text-fill: #555;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="服务器地址" style="-fx-font-weight: bold;"/>
                <TextField fx:id="hostField" text="127.0.0.1" promptText="IP 地址"/>
                <Label text="端口" style="-fx-font-weight: bold;"/>
                <TextField fx:id="portField" text="8888" promptText="端口"/>
                <Label text="你的昵称" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" promptText="玩家昵称"/>
                <Button fx:id="connectBtn" text="加入联机（需 2 人）"
                        onAction="#onConnectClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10;"/>
            </VBox>

            <Label fx:id="statusLabel" text="请先启动服务器，再连接"
                   wrapText="true"
                   style="-fx-text-fill: #333;"/>

            <ListView fx:id="waitingList" prefHeight="100" maxHeight="120"/>

            <Button text="单机游戏（本地 4 人热座）"
                    onAction="#onLocalGameClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10;"/>
        </VBox>
    </center>
</BorderPane>
