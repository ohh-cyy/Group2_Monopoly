<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LobbyController"
            prefWidth="540"
            prefHeight="460"
            style="-fx-padding: 24; -fx-background-color: #ecf0f1;">
    <center>
        <VBox spacing="14" alignment="CENTER" maxWidth="460">
            <Label text="Monopoly Deal"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <Label text="Room mode: shared folder sync without TCP"
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="Shared folder (must match on all computers)" style="-fx-font-weight: bold;"/>
                <TextField fx:id="roomsRootField"
                           promptText="Leave blank for same-computer testing, or enter a LAN share path such as \\192.168.1.5\MonopolyDealRooms"/>
                <Label text="Default: user folder/MonopolyDealRooms. The host should share this folder first."
                       wrapText="true"
                       style="-fx-font-size: 11px; -fx-text-fill: #666;"/>

                <Label text="Your name" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" promptText="Player name"/>

                <HBox spacing="8">
                    <Button fx:id="hostBtn" text="Create Room (Host)"
                            onAction="#onHostClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10;"/>
                    <Button fx:id="joinBtn" text="Join Room"
                            onAction="#onJoinClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10;"/>
                </HBox>

                <Label text="Room code (required to join)" style="-fx-font-weight: bold;"/>
                <TextField fx:id="roomCodeField" promptText="Example: 1234"/>
            </VBox>

            <Label fx:id="statusLabel" text="The host creates a room, then shares the room code with other players."
                   wrapText="true"/>

            <Label fx:id="roomCodeLabel" text=""
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>

            <ListView fx:id="playerList" prefHeight="100"/>

            <Button fx:id="startBtn" text="Start Game (2+ players, host only)"
                    onAction="#onStartClick"
                    disable="true"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="Local Hot Seat (4 players)"
                    onAction="#onLocalGameClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10;"/>
        </VBox>
    </center>
</BorderPane>
