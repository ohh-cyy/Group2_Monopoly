<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LobbyController"
            prefWidth="540"
            prefHeight="460"
            style="-fx-padding: 24; -fx-background-color: #ecf0f1;">
    <center>
        <VBox spacing="14" alignment="CENTER" maxWidth="460">
            <Label text="Monopoly Deal"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <Label text="伪联机：共享房间文件夹同步（无需 TCP）"
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="共享目录（多台电脑必须相同）" style="-fx-font-weight: bold;"/>
                <TextField fx:id="roomsRootField"
                           promptText="本机双开可留空；局域网填共享路径，如 \\192.168.1.5\MonopolyDealRooms"/>
                <Label text="本机默认: 用户目录/MonopolyDealRooms。Host 需先共享该文件夹。"
                       wrapText="true"
                       style="-fx-font-size: 11px; -fx-text-fill: #666;"/>

                <Label text="你的昵称" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" promptText="玩家昵称"/>

                <HBox spacing="8">
                    <Button fx:id="hostBtn" text="创建房间（Host）"
                            onAction="#onHostClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10;"/>
                    <Button fx:id="joinBtn" text="加入房间"
                            onAction="#onJoinClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10;"/>
                </HBox>

                <Label text="房间号（加入时填写）" style="-fx-font-weight: bold;"/>
                <TextField fx:id="roomCodeField" promptText="例如 1234"/>
            </VBox>

            <Label fx:id="statusLabel" text="Host 创建房间后会显示房间号，发给其他玩家加入"
                   wrapText="true"/>

            <Label fx:id="roomCodeLabel" text=""
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>

            <ListView fx:id="playerList" prefHeight="100"/>

            <Button fx:id="startBtn" text="开始游戏（至少 2 人，仅 Host）"
                    onAction="#onStartClick"
                    disable="true"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="单机热座（本机 4 人）"
                    onAction="#onLocalGameClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10;"/>
        </VBox>
    </center>
</BorderPane>
