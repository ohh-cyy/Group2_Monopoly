<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LobbyController"
            prefWidth="960"
            prefHeight="640"
            stylesheets="@game-theme.css"
            styleClass="lobby-root">
    <center>
        <StackPane styleClass="lobby-stage">
            <VBox spacing="18" alignment="CENTER" maxWidth="900" styleClass="lobby-shell">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="lobby-hero">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="MONOPOLY DEAL" styleClass="lobby-title"/>
                        <Label text="Card Room Lobby · 2-4 Online Players · Local Hot Seat Ready"
                               wrapText="true"
                               styleClass="lobby-subtitle"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="8">
                        <Label text="LOBBY" styleClass="lobby-pill"/>
                        <Label fx:id="achievementProgressLabel"
                               text="Achievements 0/5"
                               styleClass="lobby-progress-label"/>
                    </VBox>
                </HBox>

                <HBox spacing="18" alignment="CENTER">
                    <VBox spacing="13" HBox.hgrow="ALWAYS" maxWidth="575" styleClass="lobby-main-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🎮" styleClass="lobby-card-icon"/>
                            <VBox spacing="2">
                                <Label text="Player Setup" styleClass="lobby-section-title"/>
                                <Label text="保留原有联机与本地入口，只升级大厅展示层。" styleClass="lobby-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <GridPane hgap="10" vgap="9" styleClass="lobby-form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Server address" styleClass="lobby-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="hostField"
                                       promptText="Host IP, e.g. 127.0.0.1 or 192.168.1.5"
                                       styleClass="lobby-text-field"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Port" styleClass="lobby-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="portField"
                                       promptText="8888"
                                       styleClass="lobby-text-field"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Your name" styleClass="lobby-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="nameField"
                                       promptText="Player name"
                                       styleClass="lobby-text-field"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>

                        <HBox spacing="10">
                            <Button fx:id="hostBtn"
                                    text="Start Server (Host)"
                                    onAction="#onHostClick"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="lobby-host-button"/>
                            <Button fx:id="joinBtn"
                                    text="Join Game"
                                    onAction="#onJoinClick"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="lobby-join-button"/>
                        </HBox>

                        <Button fx:id="startBtn"
                                text="Start Game (2-4 players, host only)"
                                onAction="#onStartClick"
                                disable="true"
                                maxWidth="Infinity"
                                styleClass="lobby-start-button"/>

                        <Button text="Local Hot Seat (4 players)"
                                onAction="#onLocalGameClick"
                                maxWidth="Infinity"
                                styleClass="lobby-local-button"/>

                        <Label fx:id="statusLabel"
                               text="Host starts the server; others join with the host IP."
                               wrapText="true"
                               styleClass="lobby-status-label"/>
                    </VBox>

                    <VBox spacing="13" prefWidth="290" styleClass="lobby-side-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="👥" styleClass="lobby-card-icon"/>
                            <VBox spacing="2">
                                <Label text="Room Board" styleClass="lobby-section-title"/>
                                <Label text="Players currently waiting" styleClass="lobby-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <ListView fx:id="playerList" prefHeight="160" styleClass="lobby-player-list"/>

                        <Separator/>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🏆" styleClass="lobby-card-icon"/>
                            <VBox spacing="2">
                                <Label text="Achievement Library" styleClass="lobby-section-title"/>
                                <Label text="5 条轻量成就，可在大厅和基础操作中完成。"
                                       wrapText="true"
                                       styleClass="lobby-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <Button fx:id="achievementsBtn"
                                text="Open Achievement Library"
                                onAction="#onAchievementsClick"
                                maxWidth="Infinity"
                                styleClass="lobby-secondary-button"/>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER" styleClass="lobby-feature-row">
                    <Label text="Solo-game Lobby Feel" styleClass="lobby-feature-chip"/>
                    <Label text="Original Network Flow Kept" styleClass="lobby-feature-chip"/>
                    <Label text="Achievement Progress Saved" styleClass="lobby-feature-chip"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
