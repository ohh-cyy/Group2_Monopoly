<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LobbyController"
            prefWidth="520"
            prefHeight="480"
            style="-fx-padding: 24; -fx-background-color: #ecf0f1;">
    <center>
        <VBox spacing="14" alignment="CENTER" maxWidth="440">
            <Label text="Monopoly Deal"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #074001;"/>
            <Label text="Socket multiplayer · 2-4 players · host starts manually"
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="Server address (joiners only)" style="-fx-font-weight: bold;"/>
                <TextField fx:id="hostField" promptText="Host IP, e.g. 127.0.0.1 or 192.168.1.5"/>
                <Label text="Port" style="-fx-font-weight: bold;"/>
                <TextField fx:id="portField" promptText="8888"/>

                <Label text="Your name" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" promptText="Player name"/>

                <HBox spacing="8">
                    <Button fx:id="hostBtn" text="Start Server (Host)"
                            onAction="#onHostClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10;"/>
                    <Button fx:id="joinBtn" text="Join Game"
                            onAction="#onJoinClick"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10;"/>
                </HBox>
            </VBox>

            <Label fx:id="statusLabel" text="Host starts the server; others join with the host IP."
                   wrapText="true"/>

            <ListView fx:id="playerList" prefHeight="120"/>

            <Button fx:id="startBtn" text="Start Game (2-4 players, host only)"
                    onAction="#onStartClick"
                    disable="true"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="Local Hot Seat (4 players)"
                    onAction="#onLocalGameClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10;"/>
        </VBox>
    </center>
</BorderPane>
